{
  "name": "kudi-store",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack && node scripts/build-sw.mjs",
    "start": "next start --hostname 0.0.0.0",
    "preview": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx scripts/database.ts migrate",
    "db:seed": "node --import tsx scripts/database.ts seed",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:sql": "node --import tsx scripts/export-sql.ts"
  },
  "dependencies": {
    "@tanstack/query-async-storage-persister": "^5.90.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@tanstack/react-query-persist-client": "^5.90.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "idb-keyval": "^6.2.2",
    "lucide-react": "latest",
    "next": "latest",
    "postgres": "^4.1.0",
    "react": "latest",
    "react-dom": "latest",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "latest"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "drizzle-kit": "^0.31.11",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "latest"
  }
}
